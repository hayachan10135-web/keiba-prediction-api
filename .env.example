# ==============================================================================
# 競馬AIシステム バックエンド環境変数テンプレート (.env.example)
# 本ファイルをコピーして .env を作成し、実際の値を設定してください。
# ==============================================================================

# --- 実行環境設定 ---
ENV=production
DEBUG=false
PORT=10000

# --- データベース設定 ---
# デフォルトで最速ローカル SQLite (backend-render/data/keiba_local.db) を使用します
USE_LOCAL_SQLITE=1

# (任意・レガシー) Supabase リモートDBを使用する場合のみ設定
SUPABASE_URL=
SUPABASE_KEY=

# --- 投票運用設定 ---
# デフォルト投票モード: off / virtual / real
DEFAULT_BETTING_MODE=off
# 1日あたりの最大投資上限金額（円）
DAILY_INVESTMENT_LIMIT=30000

# --- netkeiba スクレイピング設定 ---
# (任意) netkeiba WAF/アクセス制限回避用のプロキシURL (例: http://user:pass@proxy.example.com:8080)
NETKEIBA_PROXY_URL=

# --- API 認証設定 (必須) ---
# ngrok 外部公開保護用の API キー (X-API-Key ヘッダーで検証されます)
API_KEY=

# --- JRA 即PAT 設定 (自動投票 / マニュアル投票利用時) ---
IPAT_USER_NUM=12345678
IPAT_PIN=1234
IPAT_PARS=ABCD

# --- JRA UMACAスマート 設定 (UMACA投票利用時) ---
UMACA_CARD_NUMBER=1234567890
UMACA_PIN=1234
UMACA_BIRTHDAY=0101

# --- Firebase Admin SDK 設定 (FCM プッシュ通知利用時) ---
FIREBASE_KEY_PATH=firebase_service_account.json
FIREBASE_SERVICE_ACCOUNT_KEY=

