# ==============================================================================
# 競馬AIシステム バックエンド環境変数テンプレート (.env.example)
# 本ファイルをコピーして .env を作成し、実際の値を設定してください。
# ==============================================================================

# --- 実行環境設定 ---
ENV=production
DEBUG=false

# --- Supabase データベース設定 (必須) ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# --- JRA 即PAT 設定 (自動投票 / マニュアル投票利用時) ---
IPAT_USER_NUM=12345678
IPAT_PIN=1234
IPAT_PARS=ABCD

# --- JRA UMACAスマート 設定 (UMACA投票利用時) ---
UMACA_CARD_NUMBER=1234567890
UMACA_PIN=1234
UMACA_BIRTHDAY=0101

# --- Firebase Admin SDK 設定 (FCM プッシュ通知利用時) ---
FIREBASE_KEY_PATH=firebase_service_account.json
FIREBASE_SERVICE_ACCOUNT_KEY=
